<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ch.inyourfacecomedy.robins-calendar</string>
  <!-- ekcal is the entry point so the Calendars permission is pinned on it, not on bun: see script/lib/ekcal.swift -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/harry/Code/personal/inyourfacecomedy/script/robins-out/ekcal</string>
    <string>run</string>
    <string>/Users/harry/.bun/bin/bun</string>
    <string>script/robins-calendar.ts</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/harry/Code/personal/inyourfacecomedy</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>5</integer></dict>
  <key>StandardOutPath</key><string>/Users/harry/Code/personal/inyourfacecomedy/script/robins-calendar.log</string>
  <key>StandardErrorPath</key><string>/Users/harry/Code/personal/inyourfacecomedy/script/robins-calendar.log</string>
</dict>
</plist>
