{%- comment -%}
  event-card.liquid — design-system v1
  Renders one .iyf-event-card from a post object.
  Required: post (a Jekyll page/post object with at least .title, .url).
  Optional consumed: next_event_date, venue_slug, ticket_url, price_chf, tagline,
                     image, recurrence_day, recurrence_time (undated cards only).
  Per-show palette: the `data-show` lookup on the post's permalink hooks into
                    _sass/components/_show-override.scss when the card is
                    rendered inside (or as) a .show-banner. When rendered
                    standalone (e.g. on the home grid), we add the class so
                    the card itself reads --show-*.
{%- endcomment -%}
{%- assign show_slug = post.permalink | replace: '/', '' | strip -%}
{%- assign event_date = post.next_event_date | default: nil -%}
{%- comment -%}
  The start time of a dated card comes from Eventfrog, never from the post's
  hand-typed recurrence_time (that showed Pulp Non-Fiction at 19:30 for a 19:00
  show). It is read as text out of the show's next event in _data/calendar.yml
  ("2026-11-01T19:00:00+01:00" -> "19:00"), so it does not depend on the build
  machine's time zone (Netlify builds in UTC). No calendar event, no time.
{%- endcomment -%}
{%- assign card_event = site.data.calendar.events | where: "url", post.permalink | first -%}
{%- assign card_time = '' -%}
{%- if card_event -%}{%- assign card_time = card_event.start | slice: 11, 5 -%}{%- endif -%}
<article class="iyf-event-card show-banner" data-show="{{ show_slug }}">
  {% if post.image %}
    <div class="iyf-event-card__media">
      <a href="{{ post.url | relative_url }}" aria-label="{{ post.title }}">
        <img src="{{ post.image | relative_url }}" alt="{{ post.title }}" loading="lazy">
      </a>
    </div>
  {% endif %}

  <div class="iyf-event-card__header">
    {% if event_date %}
      <div class="iyf-event-card__date" aria-hidden="true">
        <span class="iyf-event-card__day">{{ event_date | date: "%d" }}</span>
        <span class="iyf-event-card__month">{{ event_date | date: "%b" }}</span>
      </div>
    {% endif %}
    <div class="iyf-event-card__meta">
      {% if event_date %}
        <span class="iyf-event-card__weekday-time">
          {{ event_date | date: "%a" }}{% if card_time != '' %} · {{ card_time }}{% endif %}
        </span>
      {% elsif post.recurrence_day %}
        <span class="iyf-event-card__weekday-time">{{ post.recurrence_day }}{% if post.recurrence_time %} · {{ post.recurrence_time }}{% endif %}</span>
      {% endif %}
      {% if post.venue_slug %}
        <span class="iyf-event-card__venue">{{ post.venue_slug | replace: '_', ' ' | capitalize }}</span>
      {% endif %}
    </div>
  </div>

  {%- comment -%}
    Same normalize-then-split contract as _layouts/post.liquid: replace
    ' - ' with ' • ' so both bullet and space-dash-space separators
    collapse to one delimiter without touching inner hyphens like
    "Stand-Up". First segment is the show name; second segment becomes
    the small subtitle line under the title. Cards stop after parts[1]
    because tertiary segments (e.g. Comedy Brew's "EVERY Thursday at
    ROBINS…") are already covered by the date/venue meta row.
  {%- endcomment -%}
  {%- assign card_title_normalized = post.title | replace: ' - ', ' • ' -%}
  {%- assign card_title_parts = card_title_normalized | split: '•' -%}
  {%- assign card_primary_title = card_title_parts[0] | strip -%}

  <h3 class="iyf-event-card__title">
    <a href="{{ post.url | relative_url }}">{{ card_primary_title }}</a>
  </h3>

  {% if card_title_parts.size > 1 %}
    {%- assign card_secondary_title = card_title_parts[1] | strip -%}
    {% if card_secondary_title != '' %}
      <p class="iyf-event-card__subtitle">{{ card_secondary_title }}</p>
    {% endif %}
  {% endif %}

  {% if post.tagline %}
    <p class="iyf-event-card__tagline">{{ post.tagline }}</p>
  {% endif %}

  <div class="iyf-event-card__footer">
    {% if post.price_chf and post.price_chf != 0 %}
      <span class="iyf-event-card__price">CHF&nbsp;{{ post.price_chf }}</span>
    {% elsif post.price_chf == 0 %}
      <span class="iyf-event-card__price">Free</span>
    {% endif %}
    {% if post.ticket_url %}
      <span class="iyf-event-card__cta">
        <a class="btn-ticket btn-ticket--sm" href="{{ post.ticket_url }}" data-show="{{ post.url | remove: "/" }}" data-venue="{{ post.venue_slug }}" data-date="{{ post.next_event_date | date: "%Y-%m-%d" }}" data-price="{{ post.price_chf | default: 0 }}" rel="noopener" target="_blank">Get Tickets</a>
      </span>
    {% else %}
      <span class="iyf-event-card__cta">
        <a class="btn-ghost" href="{{ post.url | relative_url }}">More info</a>
      </span>
    {% endif %}
  </div>
</article>
