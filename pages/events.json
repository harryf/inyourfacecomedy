---
layout: null
permalink: /events.json
sitemap: false
---
{%- comment -%}
  Machine-readable calendar: every upcoming date of every show, for partner sites.
  robins-coffee.ch reads it at build time and keeps the dates at ROBIN's.
  Source: _data/calendar.yml (generated from Eventfrog, never hand-edited) plus each
  show post for its images and language. go_url is the tracked /go/ link, which
  resolves to the next date's ticket page when it is tapped.
{%- endcomment -%}
{
  "generated_at": {{ site.data.calendar.generated_at | jsonify }},
  "events": [
{%- for e in site.data.calendar.events -%}
{%- assign post = site.posts | where: "url", e.url | first -%}
{%- assign go = '/go/?show=' | append: e.show %}
    {
      "id": {{ e.show | append: "-" | append: e.date | jsonify }},
      "show": {{ e.show | jsonify }},
      "name": {{ e.name | jsonify }},
      "title": {{ e.title | jsonify }},
      "url": {{ e.url | absolute_url | jsonify }},
      "date": {{ e.date | jsonify }},
      "start": {{ e.start | jsonify }},
      "end": {{ e.end | jsonify }},
      "venue": {{ e.venue | jsonify }},
      "venue_name": {{ e.venue_name | jsonify }},
      "price_chf": {{ e.price_chf | jsonify }},
      "status": {{ e.status | jsonify }},
      "ticket_url": {{ e.ticket_url | jsonify }},
      "go_url": {{ go | absolute_url | jsonify }},
      "image": {% if post.feature-img %}{{ post.feature-img | absolute_url | jsonify }}{% else %}null{% endif %},
      "thumbnail": {% if post.thumbnail %}{{ post.thumbnail | absolute_url | jsonify }}{% else %}null{% endif %},
      "language": {{ post.language | default: "en" | jsonify }}
    }{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ]
}
